<?xml version="1.0"?>
<sdf version="1.8">
  <world name="hospital_l_challenge">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 -0.5 -1</direction>
    </light>

    <model name="hospital_floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>7 6 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>7 6 0.05</size></box></geometry>
          <material><ambient>0.83 0.85 0.87 1</ambient><diffuse>0.83 0.85 0.87 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="corridor_walls">
      <static>true</static>
      <link name="link">
        <collision name="south_wall">
          <pose>-0.9 -2.1 0.30 0 0 0</pose>
          <geometry><box><size>4.4 0.10 0.60</size></box></geometry>
        </collision>
        <visual name="south_wall_visual">
          <pose>-0.9 -2.1 0.30 0 0 0</pose>
          <geometry><box><size>4.4 0.10 0.60</size></box></geometry>
          <material><ambient>0.88 0.92 0.95 1</ambient><diffuse>0.88 0.92 0.95 1</diffuse></material>
        </visual>
        <collision name="north_horizontal_wall">
          <pose>-1.45 -0.9 0.30 0 0 0</pose>
          <geometry><box><size>3.3 0.10 0.60</size></box></geometry>
        </collision>
        <visual name="north_horizontal_wall_visual">
          <pose>-1.45 -0.9 0.30 0 0 0</pose>
          <geometry><box><size>3.3 0.10 0.60</size></box></geometry>
          <material><ambient>0.88 0.92 0.95 1</ambient><diffuse>0.88 0.92 0.95 1</diffuse></material>
        </visual>
        <collision name="west_vertical_wall">
          <pose>-0.6 0.35 0.30 0 0 0</pose>
          <geometry><box><size>0.10 2.5 0.60</size></box></geometry>
        </collision>
        <visual name="west_vertical_wall_visual">
          <pose>-0.6 0.35 0.30 0 0 0</pose>
          <geometry><box><size>0.10 2.5 0.60</size></box></geometry>
          <material><ambient>0.88 0.92 0.95 1</ambient><diffuse>0.88 0.92 0.95 1</diffuse></material>
        </visual>
        <collision name="east_vertical_wall">
          <pose>0.6 0.35 0.30 0 0 0</pose>
          <geometry><box><size>0.10 2.5 0.60</size></box></geometry>
        </collision>
        <visual name="east_vertical_wall_visual">
          <pose>0.6 0.35 0.30 0 0 0</pose>
          <geometry><box><size>0.10 2.5 0.60</size></box></geometry>
          <material><ambient>0.88 0.92 0.95 1</ambient><diffuse>0.88 0.92 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="route_marking">
      <static>true</static>
      <link name="link">
        <visual name="horizontal">
          <pose>-1.0 -1.5 0.031 0 0 0</pose>
          <geometry><box><size>2.0 0.05 0.012</size></box></geometry>
          <material><ambient>0.15 0.55 0.85 1</ambient><diffuse>0.15 0.55 0.85 1</diffuse></material>
        </visual>
        <visual name="vertical">
          <pose>0 -0.75 0.032 0 0 0</pose>
          <geometry><box><size>0.05 1.5 0.014</size></box></geometry>
          <material><ambient>0.15 0.55 0.85 1</ambient><diffuse>0.15 0.55 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="laboratory_destination">
      <static>true</static>
      <pose>0 0 0.033 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.35</radius><length>0.015</length></cylinder></geometry>
          <material><ambient>0.10 0.70 0.30 1</ambient><diffuse>0.10 0.70 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="movable_hospital_cart">
      <static>false</static>
      <pose>0 -0.30 0.27 0 0 0</pose>
      <link name="cart_link">
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.08</ixx><iyy>0.08</iyy><izz>0.08</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.42 0.42 0.50</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.42 0.42 0.50</size></box></geometry>
          <material><ambient>0.92 0.58 0.10 1</ambient><diffuse>0.92 0.58 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://hospital_robot</uri>
      <name>hospital_robot</name>
      <pose>-2.0 -1.5 0.025 0 0 0</pose>
    </include>
  </world>
</sdf>
