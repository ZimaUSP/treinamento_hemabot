<?xml version="1.0"?>
<sdf version="1.8">
  <world name="introduction">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 -0.5 -1</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5 3 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5 3 0.05</size></box></geometry>
          <material>
            <ambient>0.72 0.75 0.78 1</ambient>
            <diffuse>0.72 0.75 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="start_line">
      <static>true</static>
      <pose>-1.5 0 0.031 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.05 1.1 0.012</size></box></geometry>
          <material>
            <ambient>0.65 0.10 0.16 1</ambient>
            <diffuse>0.65 0.10 0.16 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="distance_markers">
      <static>true</static>
      <link name="link">
        <visual name="marker_1">
          <pose>-1.0 0 0.031 0 0 0</pose>
          <geometry><box><size>0.025 0.9 0.012</size></box></geometry>
          <material><ambient>0.96 0.76 0.12 1</ambient><diffuse>0.96 0.76 0.12 1</diffuse></material>
        </visual>
        <visual name="marker_2">
          <pose>-0.5 0 0.031 0 0 0</pose>
          <geometry><box><size>0.025 0.9 0.012</size></box></geometry>
          <material><ambient>0.96 0.76 0.12 1</ambient><diffuse>0.96 0.76 0.12 1</diffuse></material>
        </visual>
        <visual name="marker_3">
          <pose>0.0 0 0.031 0 0 0</pose>
          <geometry><box><size>0.025 0.9 0.012</size></box></geometry>
          <material><ambient>0.96 0.76 0.12 1</ambient><diffuse>0.96 0.76 0.12 1</diffuse></material>
        </visual>
        <visual name="marker_4">
          <pose>0.5 0 0.031 0 0 0</pose>
          <geometry><box><size>0.025 0.9 0.012</size></box></geometry>
          <material><ambient>0.96 0.76 0.12 1</ambient><diffuse>0.96 0.76 0.12 1</diffuse></material>
        </visual>
        <visual name="marker_5">
          <pose>1.0 0 0.031 0 0 0</pose>
          <geometry><box><size>0.025 0.9 0.012</size></box></geometry>
          <material><ambient>0.96 0.76 0.12 1</ambient><diffuse>0.96 0.76 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://hospital_robot</uri>
      <name>hospital_robot</name>
      <pose>-1.5 0 0.025 0 0 0</pose>
    </include>
  </world>
</sdf>
